# Environment
.env
.venv/
venv/
env/

# Grounding DINO (отдельный venv + артефакты)
grounding_dino_service/.venv/
grounding_dino_service/test.jpg
grounding_dino_service/uploads/*
!grounding_dino_service/uploads/.gitkeep
grounding_dino_service/outputs/*
!grounding_dino_service/outputs/.gitkeep

# SAM2 (отдельный venv + артефакты)
sam2_service/.venv/
sam2_service/external/
sam2_service/checkpoints/*.pt
sam2_service/outputs/*
!sam2_service/outputs/.gitkeep
!sam2_service/checkpoints/.gitkeep
sam2_service/test_images/test.jpg

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# YouTube cookies (ручной экспорт; не в репозиторий)
data/secrets/*
!data/secrets/.gitkeep

# Data (jobs contain prompts, keep local)
data/jobs/*.json
data/rewrite_jobs/*.json
data/logs/*
data/input/*

# Image reference templates (user content; keep only marker in git)
image_templates/*
!image_templates/.gitkeep
# legacy symlink data/image_templates → ../image_templates
data/image_templates

# Per-job TTS audio (ElevenLabs)
data/job_audio/*
!data/job_audio/.gitkeep

# Per-job Pexels cached media
data/job_pexels/

# Per-job Remotion-rendered videos (артефакты, не уходят в репо)
data/job_videos/

# Per-job Remotion bundle (props.json + локальные копии медиа сцен) — артефакты
data/job_remotion/

# Scenes-lab runtime (сессия Later…, props/out.mp4, загрузки)
data/scenes_lab/remotion/
data/scenes_lab/later_session.json
data/scenes_lab/later_prefs.json
data/scenes_lab/img_*/
data/scenes_lab_uploads/

# Scenes Map runtime (сессия, block JSONL, prefs)
data/scenes_map/

# Scenes Stock runtime (сессия, Pexels-кэш, prefs с API key)
data/scenes_stock/media/
data/scenes_stock/prefs.json

# Overlay Text runtime
data/overlay_text/prefs.json
data/overlay_text/uploads/
data/overlay_text/remotion/

# ReWrite runtime media (локальные артефакты)
data/rewrite_media/

# ReWrite job folders (промпты, артефакты; job_*.json уже игнорируются выше)
data/rewrite_jobs/job_*/

# Per-job locks / tmp atomic write files
data/jobs/*.lock
data/jobs/*.tmp
data/jobs/*.json.*.tmp

# Background task manager runtime state per rewrite project
data/rewrite_jobs/*/_tasks/

# Keep folder structure
!data/jobs/.gitkeep
!data/rewrite_jobs/.gitkeep
!data/logs/.gitkeep
!data/input/.gitkeep

# Remotion (Node) — храним исходники, игнорируем артефакты
remotion/node_modules/
remotion/build/
remotion/out/
remotion/.cache/
remotion/.remotion/
remotion/scene_renders/
remotion/public/jobs/
remotion/public/overlay-text
remotion/public/overlay-text/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
