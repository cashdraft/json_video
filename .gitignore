# Environment
.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Data (jobs contain prompts, keep local)
data/jobs/*.json
data/logs/*
data/input/*

# Image reference templates (user content; keep only marker in git)
data/image_templates/*
!data/image_templates/.gitkeep

# Per-job TTS audio (ElevenLabs)
data/job_audio/*
!data/job_audio/.gitkeep

# Keep folder structure
!data/jobs/.gitkeep
!data/logs/.gitkeep
!data/input/.gitkeep
