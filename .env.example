# OpenAI — ReWrite Master (раздел /rewrite, проекты в data/rewrite_jobs/)
# Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Таймаут HTTP к api.openai.com в секундах (60–3600), по умолчанию 600
OPENAI_CHAT_TIMEOUT=

# ElevenLabs — Text to Speech (страница проекта → блок «Озвучка»)
# Ключ: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Kie.ai API (Nano Banana Pro для изображений)
# Получить ключ: https://kie.ai/api-key
KEYAI_API_KEY=

# Публичный URL этого приложения (без слэша в конце), чтобы Kie.ai мог скачать
# картинки из image_templates/ при генерации с шаблоном.
# Пример: http://72.56.116.130:5000
PUBLIC_BASE_URL=

# GitHub (для git push)
# PAT: github.com/settings/tokens
GITHUB_USERNAME=
GITHUB_PAT=
